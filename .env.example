FLEETOPS_CONFIG_PATH=config/hosts.yml
FLEETOPS_DEMO_MODE=false
FLEETOPS_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
FLEETOPS_SSH_PRIVATE_KEY_PATH=/absolute/path/to/id_ed25519
FLEETOPS_SSH_KNOWN_HOSTS_PATH=config/known_hosts.local
# Optional for test/dev hosts. Prefer SSH keys for production.
FLEETOPS_SSH_PASSWORD=

# Docker Compose reads these host paths and mounts them at /run/secrets/*.
FLEETOPS_SSH_PRIVATE_KEY_SOURCE=./secrets/fleetops_ssh_key
FLEETOPS_SSH_KNOWN_HOSTS_SOURCE=./config/known_hosts.local

